":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_8HUAhazmhLBaak6","Element":"SQ","PrimaryAttribute":"QID880","SecondaryAttribute":"Please type in the first name of the person you thought of. (This is ONLY for the purpose of remi...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"caret-color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-family: Arial; font-size: 16px; white-space: pre-wrap;\">Please type in the first name of the person you thought of. (This is ONLY for the purpose of reminding you of the person later, and we will NOT store this name in any way.)<\/span>","DefaultChoices":false,"DataExportTag":"Q455","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","AllowFreeResponse":"false"},"QuestionDescription":"Please type in the first name of the person you thought of. (This is ONLY for the purpose of remi...","DisplayLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID342","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID342\/SelectableChoice\/4","Operator":"Selected","QuestionIDFromLocator":"QID342","LeftOperand":"q:\/\/QID342\/SelectableChoice\/4","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">A.FatherU18.Pre<\/span> <span class=\"LeftOpDesc\">Yes<\/span> <span class=\"OpDesc\">Is Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression","inPage":false},"Validation":{"Settings":{"ForceResponse":"RequestResponse","ForceResponseType":"RequestResponse","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID880"}},{"SurveyID":"SV_8HUAhazmhLBaak6","Element":"SQ","PrimaryAttribute":"QID881","SecondaryAttribute":"Now consider a good relationship between a father and non-adult child. That is, consider the best...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"color:#000000;\"><span id=\"docs-internal-guid-ede057b0-7fff-1820-d47c-1534a66d3d78\"><span style=\"font-family: Arial; font-size: 12pt; background-color: transparent; font-variant-ligatures: normal; font-variant-east-asian: normal; font-variant-position: normal; vertical-align: baseline; white-space: pre-wrap;\">Now consider a <u>good<\/u> relationship between<\/span><span style=\"font-size: 12pt; background-color: transparent; font-variant-ligatures: normal; font-variant-east-asian: normal; font-variant-position: normal; vertical-align: baseline; white-space: pre-wrap;\"><span style=\"font-weight: 700;\"> <\/span><span style=\"font-weight: 700;\">a<\/span><span style=\"font-weight: 700;\"> father and <u>non-adult<\/u> child. <\/span><\/span><\/span><span style=\"font-family: Arial; caret-color: rgb(0, 0, 0); font-size: 16px; white-space: pre-wrap;\">That is, consider the best relationship that a father and non-adult child could have with one another (in terms of a relationship of that kind).<\/span><\/span><br \/>\n<br \/>\n<span style=\"font-size:16px;\"><span style=\"color:#000000;\">This refers to fathers and their non-adult (meaning <u><strong>under<\/strong><\/u> age 18) children. It includes both biological and adoptive fathers\/children.<\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<div>\n<p><span style=\"color:#000000;\"><span style=\"font-family: Arial; font-size: 16px; white-space: pre-wrap;\">For each of the functions below, please move the slider to show how much you think a <u>good<\/u> relationship of this kind would<\/span><span style=\"font-family: Arial; font-size: 16px; white-space: pre-wrap;\"> serve that function. If you think it doesn&#39;t matter or it&#39;s neutral whether the relationship serves that function, please select &quot;0&quot; (you will have to move the slider away and back to do so).<\/span><\/span><\/p>\n<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Now consider a good relationship between a father and no