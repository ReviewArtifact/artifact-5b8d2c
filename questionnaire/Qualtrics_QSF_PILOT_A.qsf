341796875},"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"AttentionCheckNegative100","Choices":{"1":{"Display":""}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"RequestResponse","ForceResponseType":"RequestResponse","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":4,"Labels":{"1":{"Display":"Definitely SHOULD NOT"},"2":{"Display":"Neutral"},"3":{"Display":"Definitely SHOULD"}},"QuestionID":"QID943"}},{"SurveyID":"SV_8HUAhazmhLBaak6","Element":"SQ","PrimaryAttribute":"QID944","SecondaryAttribute":"We are going to introduce you to four functions that a relationship can serve.\u00a0 We then ask you,...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"color:#000000;\"><span style=\"font-size:16px;\">We are going to introduce you to four functions that a relationship can serve.&nbsp;<\/span><\/span><\/span><\/p><p><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"color:#000000;\"><span style=\"font-size:16px;\"><br><\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"color:#000000;\"><span style=\"font-size:16px;\">We then ask you, for each specific relationship, how much that <u>type<\/u> of relationship would ideally serve each function.<\/span><\/span><\/span><\/p><p><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"color:#000000;\"><span style=\"font-size:16px;\"><br><\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"color:#000000;\"><span style=\"font-size:16px;\">On the next page, we introduce you to the four different relationship functions. Be sure to carefully read the description of each one, because we want your honest and informed judgments on this task. So, <strong>please don\u2019t just skim over the descriptions on the following page.<\/strong> Instead, read each one carefully and make sure you understand what it\u2019s saying.&nbsp;<\/span><\/span><\/span><\/p><p><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"color:#000000;\"><span style=\"font-size:16px;\"><br><\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"color:#000000;\"><span style=\"font-size:16px;\"><u>We will ask you some questions later to confirm you\u2019ve understood, and we will only be able to use your responses if you answer correctly.<\/u><\/span><\/span><\/span><\/p><p><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"color:#000000;\"><span style=\"font-size:16px;\"><u><br><\/u><\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"color:#000000;\"><span style=\"font-size:16px;\">When you are ready, click the arrow to advance to the next page.<\/span><\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>","DefaultChoices":false,"DataExportTag":"Q351","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"We are going to introduce you to four functions that a relationship can serve.\u00a0 We then ask you,...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID944"}},{"SurveyID":"SV_8HUAhazmhLBaak6","Element":"SQ","PrimaryAttribute":"QID945","SecondaryAttribute":"How are you feeling right now?","TertiaryAttribute":null,"Payload":{"QuestionText":"How are you feeling right now?<br>","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How are you feeling right now?","Choices":{"1":{"Display":"","Image":{"Display":"Screenshot 2024 04 21 at 6.46.59 pm","ImageLocation":"IM_5nnyNOZcTDYXL7M"}},"2":{"Display":"","Image":{"Display":"Screen