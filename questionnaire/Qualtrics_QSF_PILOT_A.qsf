/div>","DataExportTag":"MateQuiz2","QuestionID":"QID874"}},{"SurveyID":"SV_8HUAhazmhLBaak6","Element":"SQ","PrimaryAttribute":"QID875","SecondaryAttribute":"That was not the correct answer.\u00a0 \u00a0 You will now be taken to the end of this survey.","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\"><span style=\"color: rgb(255, 0, 0);\">That was not the correct answer.&nbsp;<\/span><\/span>\n<div>&nbsp;<\/div>\n\n<div><span style=\"color:#000000;\"><span style=\"font-size:16px;\">You will now be taken to the end of this survey.<\/span><\/span><\/div>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"That was not the correct answer.\u00a0 \u00a0 You will now be taken to the end of this survey.","Choices":{"1":{"Display":"<span style=\"color:#000000;\"><span style=\"font-size:16px;\">I understand.<\/span><\/span>"}},"DisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID874\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Mate.2nd.Strike<\/span> <span class=\"LeftOpDesc\">&lt;span style=\"color:#000000;\"&gt;&lt;span style=\"font-size:16px;\"&gt;To make sure that individuals have strong platonic friendships&lt;\/span&gt;&lt;\/span&gt;<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID874\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID874","QuestionIDFromLocator":"QID874","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID874\/SelectableChoice\/2","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Mate.2nd.Strike<\/span> <span class=\"LeftOpDesc\">&lt;span style=\"color:#000000;\"&gt;&lt;span style=\"font-size:16px;\"&gt;To make sure that groups stay bonded together&lt;\/span&gt;&lt;\/span&gt;<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/