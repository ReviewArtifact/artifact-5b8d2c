style=\"text-align: center;\">Definitely should not<br \/>\n-4<\/div>\n"},"5":{"Display":"-3"},"6":{"Display":"-2"},"7":{"Display":"-1"},"8":{"Display":"<div style=\"text-align: center;\">Neutral<br \/>\n0<\/div>\n"},"9":{"Display":"1"},"10":{"Display":"2"},"11":{"Display":"3"},"12":{"Display":"<div style=\"text-align: center;\">Definitely should<br \/>\n4<\/div>\n"}},"ChoiceOrder":["1","5","6","7","8","9","10","11","12"],"Validation":{"Settings":{"ForceResponse":"RequestResponse","ForceResponseType":"RequestResponse","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":13,"NextAnswerId":7,"RecodeValues":{"1":"1","5":"2","6":"3","7":"4","8":"5","9":"6","10":"7","11":"8","12":"9"},"QuestionText_Unsafe":"<span style=\"color:#999999;\"><strong>Imagine a&nbsp;<u>well-functioning<\/u>&nbsp;instance of the relationship depicted below.<\/strong>&nbsp;Pay attention to&nbsp;<u>what role<\/u>&nbsp;each individual is in.<\/span><br>\n<br>\n${lm:\/\/Field\/3}<br>\n<strong>Mating function:<\/strong> In the context of this relationship, should the <u>Human<\/u> behave in a romantic way toward the <u>Superintelligent AI<\/u>?","DataExportTag":"Mating_Human1","QuestionID":"QID1131"}},{"SurveyID":"SV_8HUAhazmhLBaak6","Element":"SQ","PrimaryAttribute":"QID1132","SecondaryAttribute":"Imagine a\u00a0well-functioning\u00a0instance of the relationship depicted below.\u00a0Pay attention to\u00a0what ro","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"color:#999999;\"><strong>Imagine a&nbsp;<u>well-functioning<\/u>&nbsp;instance of the relationship depicted below.<\/strong>&nbsp;Pay attention to&nbsp;<u>what role<\/u>&nbsp;each individual is in.<\/span><br>\n<br>\n${lm:\/\/Field\/3}<br>\n<strong>Mating function:&nbsp;<\/strong>In the context of this relationship, should&nbsp;<u>Human 2<\/u>&nbsp;behave in a romantic way toward&nbsp;<u>Human 1<\/u>?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"